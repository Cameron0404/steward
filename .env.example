# Copy to $STEWARD_HOME/.env (default ~/.steward/.env) or export these in your shell.
# Every value here is a placeholder or a default. None of them is a secret.

# Where runs, health files and the queue live.
STEWARD_HOME=~/.steward
# IANA time zone for timestamps. Leave unset to use the machine's zone.
# STEWARD_TZ=Europe/London
# The claude binary. Leave unset to use `claude` on PATH.
# STEWARD_CLAUDE=/usr/local/bin/claude
# The session's working directory when a run names no repo.
# STEWARD_WORKDIR=~/code

# Wind-down at this percentage of the five-hour window (also settable in health/threshold).
STEWARD_THRESHOLD=90
# Weekly window: wind down running runs here, and start no new non-Haiku runs above the second.
STEWARD_WEEKLY_WINDDOWN=95
STEWARD_WEEKLY_NO_NEW_RUNS=92
# Managed runs at once (also settable as {"slots": N} in health/capacity.json).
STEWARD_MAX_CONCURRENT=6
# Dollar ceiling for one launch (passed to claude --max-budget-usd). 0 for none.
STEWARD_BUDGET_USD=25
# Rotate to a fresh session past this many tokens of context.
STEWARD_ROTATE_TOKENS=130000
# Nudge a run that has not written its checkpoint for this many minutes. 0 turns it off.
STEWARD_NUDGE_MINUTES=20
# Fallback models, best first, when one runs out of credits.
STEWARD_MODEL_LADDER=claude-opus-5-5,claude-sonnet-5,claude-haiku-4-5-20251001

# Permissions for headless runs. bypassPermissions is the default because nobody answers prompts.
STEWARD_PERMISSION_MODE=bypassPermissions
# A Claude Code settings file (deny rules, hooks) applied to every managed run.
# STEWARD_SETTINGS=~/.steward/headless-settings.json

# A command run with three arguments (text, note, subject) when a run needs a person.
# STEWARD_NOTIFY_CMD=/path/to/your-notify-script
# Optional files quoted into every prompt.
# STEWARD_STYLE_FILE=~/.steward/style.md
# STEWARD_STRETCH_FILE=~/.steward/stretch.md
